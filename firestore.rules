rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Users Collection (Profiles, Preferences & Favorites) ---
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /preferences/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /favorites/{favoriteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // --- Cafes Collection ---
    match /cafes/{cafeId} {
      // Anyone can read cafe details
      allow read: if true;
      allow write: if false;

      // Menu & Products Subcollections
      match /menuCategories/{categoryId} {
        allow read: if true;
        allow write: if false;

        match /products/{productId} {
          allow read: if true;
          allow write: if false;
        }
      }

      // --- Reviews Subcollection ---
      match /reviews/{reviewId} {
        // Publicly readable according to the app's access model
        allow read: if true;

        // Creating a review requires an authenticated user and matching userId + cafeId
        allow create: if request.auth != null
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.cafeId == cafeId;

        // Updating is allowed only for the original author; userId cannot be transferred
        allow update: if request.auth != null
                      && resource.data.userId == request.auth.uid
                      && request.resource.data.userId == request.auth.uid;

        // Deleting is allowed only for the original author
        allow delete: if request.auth != null
                      && resource.data.userId == request.auth.uid;
      }
    }
  }
}
